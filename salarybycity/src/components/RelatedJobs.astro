---
import type { Occupation, StateInfo } from '../lib/salary';
import { fmtUSD, getRelatedOccupations, getSalary, salaryPath } from '../lib/salary';

interface Props {
  occupation: Occupation;
  state: StateInfo;
}

const { occupation, state } = Astro.props;
const related = getRelatedOccupations(occupation);
---

<ul class="grid gap-3 sm:grid-cols-2">
  {related.map((occ) => {
    const median = getSalary(occ, state).median;
    return (
      <li>
        <a
          href={salaryPath(occ.slug, state.slug)}
          class="block rounded-xl border border-stone-200 bg-white p-4 transition-colors hover:border-blue-400 dark:border-stone-800 dark:bg-stone-900 dark:hover:border-blue-500"
        >
          <span class="font-semibold text-blue-700 dark:text-blue-400">{occ.title}</span>
          <span class="mt-1 block text-sm text-stone-500 dark:text-stone-400">
            Median in {state.name}: <span class="font-medium text-stone-700 dark:text-stone-200">{fmtUSD(median)}</span>
          </span>
        </a>
      </li>
    );
  })}
</ul>
