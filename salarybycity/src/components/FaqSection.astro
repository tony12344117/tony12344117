---
import type { Faq } from '../lib/salary';

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;
---

<div class="space-y-3">
  {faqs.map((faq) => (
    <details class="group rounded-xl border border-stone-200 bg-white p-4 dark:border-stone-800 dark:bg-stone-900">
      <summary class="cursor-pointer font-semibold marker:text-blue-600">{faq.question}</summary>
      <p class="mt-3 text-stone-600 dark:text-stone-300">{faq.answer}</p>
    </details>
  ))}
</div>
