---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DATA_YEAR, fmtUSD, occupations, salaryPath, states } from '../../lib/salary';

const sorted = [...occupations].sort((a, b) => b.national.median - a.national.median);
---

<BaseLayout
  title={`Salaries by Job (${DATA_YEAR}): Browse All Occupations`}
  description={`Browse ${DATA_YEAR} salary data for ${occupations.length} occupations across U.S. states — median pay, percentile ranges, cost-of-living context, and state-by-state comparisons.`}
>
  <section class="py-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Salaries by job</h1>
    <p class="mt-3 max-w-2xl text-stone-600 dark:text-stone-300">
      National median pay for each occupation, with state-level pages showing how salaries shift with
      local demand, cost of living, and taxes. Pick a job, then a state.
    </p>
  </section>

  <div class="grid gap-4 sm:grid-cols-2">
    {sorted.map((occ) => (
      <article class="rounded-xl border border-stone-200 bg-white p-5 dark:border-stone-800 dark:bg-stone-900">
        <p class="text-xs font-semibold uppercase tracking-wide text-stone-400">{occ.category}</p>
        <h2 class="mt-1 text-lg font-bold">{occ.title}</h2>
        <p class="mt-1 text-sm text-stone-500 dark:text-stone-400">
          National median: <span class="font-semibold text-stone-800 dark:text-stone-100">{fmtUSD(occ.national.median)}</span>/yr
        </p>
        <p class="mt-2 text-sm text-stone-600 dark:text-stone-300">{occ.shortDesc}</p>
        <div class="mt-4 flex flex-wrap gap-2">
          {states.map((s) => (
            <a
              href={salaryPath(occ.slug, s.slug)}
              class="rounded-full border border-stone-200 px-3 py-1 text-xs font-medium text-blue-700 hover:border-blue-400 hover:bg-blue-50 dark:border-stone-700 dark:text-blue-400 dark:hover:bg-blue-950/40"
            >
              {s.name}
            </a>
          ))}
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
